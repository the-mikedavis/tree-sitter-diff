{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "diff",
      "scope": "source.diff",
      "path": ".",
      "file-types": [
        "diff"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^diff$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "A tree-sitter grammar for diffs",
    "authors": [
      {
        "name": "the-mikedavis"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-diff"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
